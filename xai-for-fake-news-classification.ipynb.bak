    "import joblib, json, pathlib, torch\n",
    "\n",
    "# Auto-detect Kaggle environment; fall back to a local artifacts/ directory.\n",
    "_kaggle_out = pathlib.Path('/kaggle/working')\n",
    "ARTIFACTS_DIR = (_kaggle_out / 'artifacts') if _kaggle_out.exists() else pathlib.Path('artifacts')\n",
    "ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# --- Classical models + TF-IDF vectorizer ---\n",
    "joblib.dump(tfidf,      ARTIFACTS_DIR / 'tfidf.joblib',      compress=3)\n",
    "joblib.dump(lr_model,   ARTIFACTS_DIR / 'lr_model.joblib',   compress=3)\n",
    "joblib.dump(rf_model,   ARTIFACTS_DIR / 'rf_model.joblib',   compress=3)\n",
    "joblib.dump(xgb_model,  ARTIFACTS_DIR / 'xgb_model.joblib',  compress=3)\n",
    "joblib.dump(lgbm_model, ARTIFACTS_DIR / 'lgbm_model.joblib', compress=3)\n",
    "\n",
    "# --- LSTM weights + vocabulary ---\n",
    "torch.save(lstm_model.state_dict(), ARTIFACTS_DIR / 'lstm_model.pt')\n",
    "with open(ARTIFACTS_DIR / 'vocab.json', 'w') as _f:\n",
    "    json.dump(vocab, _f)\n",
    "\n",
    "# --- DistilBERT MLP head (encoder downloaded from HF Hub at app startup) ---\n",
    "torch.save(head.state_dict(), ARTIFACTS_DIR / 'bert_head.pt')\n",
    "\n",
    "# --- Constants needed at inference time ---\n",
    "_config = {\n",
    "    'LSTM_MAX_LEN':    LSTM_MAX_LEN,\n",
    "    'LSTM_MAX_VOCAB':  LSTM_MAX_VOCAB,\n",
    "    'LSTM_EMBED_DIM':  LSTM_EMBED_DIM,\n",
    "    'LSTM_HIDDEN_DIM': LSTM_HIDDEN_DIM,\n",
    "    'BERT_MODEL_NAME': MODEL_NAME,\n",
    "    'BERT_MAX_LEN':    MAX_LEN,\n",
    "    'BERT_BATCH_SIZE': BATCH_SIZE,\n",
    "}\n",
    "with open(ARTIFACTS_DIR / 'config.json', 'w') as _f:\n",
    "    json.dump(_config, _f, indent=2)\n",
    "\n",
    "print('Artifacts saved to', ARTIFACTS_DIR.resolve())\n",
    "for _p in sorted(ARTIFACTS_DIR.iterdir()):\n",
