   "source": [
    "# Install only packages not already present.\n",
    "# shap uses --no-deps to avoid pulling a newer numba that conflicts with\n",
    "# Kaggle's pre-installed RAPIDS stack (dask-cuda, cuml, cudf).\n",
    "import importlib, subprocess, sys\n",
    "\n",
    "def _pip(*pkgs, no_deps=False):\n",
    "    cmd = [sys.executable, '-m', 'pip', 'install', '-q']\n",
    "    if no_deps:\n",
    "        cmd.append('--no-deps')\n",
    "    cmd.extend(pkgs)\n",
    "    subprocess.check_call(cmd)\n",
    "\n",
    "def _has(mod):\n",
    "    return importlib.util.find_spec(mod) is not None\n",
    "\n",
    "if not _has('sklearn'):       _pip('scikit-learn')\n",
    "if not _has('xgboost'):       _pip('xgboost')\n",
    "if not _has('lightgbm'):      _pip('lightgbm')\n",
    "if not _has('nltk'):          _pip('nltk')\n",
    "if not _has('torch'):         _pip('torch')\n",
    "if not _has('transformers'):  _pip('transformers')\n",
    "if not _has('shap'):\n",
    "    _pip('shap', no_deps=True)          # avoids numba upgrade -> RAPIDS conflict\n",
    "    _pip('cloudpickle', 'slicer')       # shap runtime deps not in pre-installed env\n",
    "\n",
    "print('All dependencies ready.')"
   ]
  },
  {
   "cell_type": "code",
