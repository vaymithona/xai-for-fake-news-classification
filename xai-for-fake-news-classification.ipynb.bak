      "TF-IDF train: (50496, 5000)  test: (12625, 5000)\n"
     ]
    }
   ],
   "source": [
    "tfidf = TfidfVectorizer(\n",
    "    max_df=0.90,\n",
    "    min_df=2,\n",
    "    max_features=5000,\n",
    "    stop_words='english',\n",
    ")\n",
    "X_train_tfidf = tfidf.fit_transform(X_train_text)\n",
    "X_test_tfidf  = tfidf.transform(X_test_text)\n",
    "print(f'TF-IDF train: {X_train_tfidf.shape}  test: {X_test_tfidf.shape}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a2df2f25",
   "metadata": {
    "papermill": {
