   "source": [
    "### 5.5 Train / Test Split\n",
    "\n",
    "A stratified **80 / 20** split with a fixed random state is used throughout the notebook so that every model is trained on the same 80 % of articles and evaluated on the same 20 % held-out test set."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "81065f7d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T18:49:02.463210Z",
     "iopub.status.busy": "2026-06-11T18:49:02.462381Z",
     "iopub.status.idle": "2026-06-11T18:49:02.533426Z",
     "shell.execute_reply": "2026-06-11T18:49:02.532374Z"
    },
    "papermill": {
     "duration": 0.085949,
     "end_time": "2026-06-11T18:49:02.535505+00:00",
     "exception": false,
     "start_time": "2026-06-11T18:49:02.449556+00:00",
     "status": "completed"
    },
    "tags": []
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train: 50,496  Test: 12,625\n"
     ]
    }
   ],
   "source": [
    "le = LabelEncoder()\n",
    "y_encoded = le.fit_transform(df['label'])\n",
    "\n",
    "# 80 / 20 stratified train/test split.\n",
    "X_train_text, X_test_text, y_train, y_test = train_test_split(\n",
    "    df['combined_clean'].values, y_encoded,\n",
    "    test_size=0.20, random_state=RANDOM_STATE, stratify=y_encoded,\n",
    ")\n",
    "\n",
    "# Parallel split on the raw (uncleaned) text for the transformer pipeline.\n",
    "# Same seed -> identical indices, so train/test contain the same articles.\n",
    "X_train_raw, X_test_raw, _, _ = train_test_split(\n",
    "    df['combined_raw'].values, y_encoded,\n",
    "    test_size=0.20, random_state=RANDOM_STATE, stratify=y_encoded,\n",
    ")\n",
    "\n",
    "print(f'Train: {len(X_train_text):,}  Test: {len(X_test_text):,}')"
   ]
  },
  {
