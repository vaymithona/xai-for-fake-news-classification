   "source": [
    "## 6. Classical Machine Learning Baselines\n",
    "\n",
    "### 6.1 TF-IDF Vectorization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9718a5bd",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T18:49:02.584659Z",
     "iopub.status.busy": "2026-06-11T18:49:02.584245Z",
     "iopub.status.idle": "2026-06-11T18:49:17.294762Z",
     "shell.execute_reply": "2026-06-11T18:49:17.293788Z"
    },
    "papermill": {
     "duration": 14.724832,
     "end_time": "2026-06-11T18:49:17.296608+00:00",
     "exception": false,
     "start_time": "2026-06-11T18:49:02.571776+00:00",
