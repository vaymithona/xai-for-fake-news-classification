      "Logistic Regression  SHAP values: (2000, 5000)\n",
      "Random Forest        SHAP values: (2000, 5000)\n",
      "XGBoost              SHAP values: (2000, 5000)\n",
      "LightGBM             SHAP values: (2000, 5000)\n"
     ]
    },
    {
     "name": "stderr",
