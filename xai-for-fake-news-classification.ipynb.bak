   "source": [
    "### 10.4 Cross-Architecture Agreement\n",
    "\n",
    "With the explanation method now held fixed, we can ask the controlled question directly: **do the six architectures rely on the same words?** Because the Text masker tokenised the *Confident Fake* article identically for every model, the per-model top tokens live in the same vocabulary and can be compared without any stem-matching heuristic. The cell below lists each model's most influential tokens and renders a model x model overlap matrix of their top-10 lists."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "a20aca94",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T21:50:38.375024Z",
     "iopub.status.busy": "2026-06-11T21:50:38.374074Z",
     "iopub.status.idle": "2026-06-11T21:50:38.704342Z",
     "shell.execute_reply": "2026-06-11T21:50:38.703452Z"
    },
    "papermill": {
     "duration": 0.434601,
     "end_time": "2026-06-11T21:50:38.706576+00:00",
     "exception": false,
     "start_time": "2026-06-11T21:50:38.271975+00:00",
     "status": "completed"
    },
    "tags": []
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Logistic Regression : ['Ms.', 'Wednesday,', 'Doe', 'today,', 'said:', 'that', 'conference', 'However,', 'why.', 'canceled,']\n",
      "Random Forest       : ['said:', 'Wednesday,', 'On', 'canceled,', 'Doe', 'Jane', 'up.', 'show', 'Ms.', 'conference']\n",
      "XGBoost             : ['said:', 'knows', 'nobody', 'canceled,', 'as', 'today,', 'why.', 'However,', 'Ms.', 'Doe']\n",
      "LightGBM            : ['said:', 'knows', 'today,', 'Ms.', 'Doe', 'nobody', 'as', 'Wednesday,', 'On', 'living']\n",
      "LSTM                : ['getting', 'Donald', 'said:', 'accused', 'Trump', 'slated', 'canceled,', 'lawyer', 'She', 'been']\n",
      "DistilBERT + MLP    : ['Trump', 'Woman', 'Raped', 'Bloom,', 'week,', 'Dropping', 'threats,', 'said:', 'the', 'Lisa']\n"
     ]
    },
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 750x600 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Top Fake-pushing tokens per model on the shared 'Confident Fake' article (index 0)\n",
    "art_j = example_labels.index('Confident Fake')\n",
    "\n",
    "def top_local_tokens(sv, j, k=10):\n",
    "    e = sv[j, :, 1]\n",
    "    vals = np.asarray(e.values)\n",
    "    toks = np.asarray(e.data)\n",
    "    out = []\n",
    "    for o in np.argsort(np.abs(vals))[::-1]:\n",
    "        tok = str(toks[o]).strip()\n",
    "        if tok:\n",
    "            out.append(tok)\n",
    "        if len(out) >= k:\n",
    "            break\n",
    "    return out\n",
    "\n",
    "top_local = {name: top_local_tokens(sv, art_j) for name, sv in local_sv.items()}\n",
    "for name, toks in top_local.items():\n",
    "    print(f'{name:20s}: {toks}')\n",
    "\n",
    "models_list = list(top_local.keys())\n",
    "M = np.zeros((len(models_list), len(models_list)), dtype=int)\n",
    "for a, na in enumerate(models_list):\n",
    "    for b, nb_ in enumerate(models_list):\n",
    "        M[a, b] = len(set(top_local[na]) & set(top_local[nb_]))\n",
    "overlap_df = pd.DataFrame(M, index=models_list, columns=models_list)\n",
    "\n",
    "plt.figure(figsize=(7.5, 6))\n",
    "sns.heatmap(overlap_df, annot=True, fmt='d', cmap='Blues',\n",
    "            cbar_kws={'label': 'shared top-10 tokens'})\n",
    "plt.title(\"Cross-architecture agreement on the 'Confident Fake' article\\n(shared top-10 SHAP tokens)\")\n",
    "plt.xticks(rotation=30, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
