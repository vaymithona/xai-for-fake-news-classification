   "source": [
    "import glob, pathlib\n",
    "\n",
    "def _find_dataset():\n",
    "    for p in [\n",
    "        '/kaggle/input/fake-news-classification/WELFake_Dataset.csv',\n",
    "        '/kaggle/input/welfake-dataset/WELFake_Dataset.csv',\n",
    "        '/kaggle/input/datasets/saurabhshahane/fake-news-classification/WELFake_Dataset.csv',\n",
    "        'WELFake_Dataset.csv',\n",
    "    ]:\n",
    "        if pathlib.Path(p).exists():\n",
    "            return p\n",
    "    hits = glob.glob('/kaggle/input/**/WELFake*.csv', recursive=True)\n",
    "    if hits:\n",
    "        return hits[0]\n",
    "    hits = glob.glob('/kaggle/input/**/*.csv', recursive=True)\n",
    "    if hits:\n",
    "        return hits[0]\n",
    "    raise FileNotFoundError(\"WELFake_Dataset.csv not found. Attach via Add Data -> saurabhshahane/fake-news-classification\")\n",
    "\n",
    "DATASET_PATH = _find_dataset()\n",
    "df = pd.read_csv(DATASET_PATH)\n",
    "print(f'Loaded from: {DATASET_PATH}')\n",
    "print(f'Rows: {df.shape[0]:,}')\n",
    "print(f'Columns: {df.shape[1]}')\n",
    "df.head()"
   ]
  },
