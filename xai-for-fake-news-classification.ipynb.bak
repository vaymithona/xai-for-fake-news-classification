     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Logistic Regression : ['said', 'reuter', 'imag', 'video', 'mr', 'hillari', 'breitbart', 'twitter', 'trump', 'obama', 'york', 'dont', 'washington', 'tuesday', 'wednesday']\n",
      "Random Forest       : ['reuter', 'video', 'york', 'campaign', 'twitter', 'look', 'said', 'sourc', 'senior', 'dont', 'sander', 'contend', 'percent', 'suprem', 'propos']\n",
      "XGBoost             : ['rt', 'com', 'getti', 'said', 'breitbart', 'что', 'nyt', 'flickr', 'factbox', 'york', 'wikileak', 'oct', 'wire', 'andor', 'socal']\n",
      "LightGBM            : ['reuter', 'said', 'imag', 'york', 'breitbart', 'video', 'twitter', 'hillari', 'dont', 'mr', 'octob', 'novemb', 'know', 'com', 'presid']\n",
      "\n",
      "Shared by ALL four classical models (top-15): ['said', 'york']\n"
     ]
    }
   ],
   "source": [
    "def top_tokens(sv, k=15):\n",
    "    order = np.argsort(np.abs(sv).mean(axis=0))[::-1][:k]\n",
    "    return list(feature_names[order])\n",
    "\n",
    "top_by_model = {name: top_tokens(sv) for name, sv in classical_shap.items()}\n",
    "for name, toks in top_by_model.items():\n",
    "    print(f'{name:20s}: {toks}')\n",
    "\n",
    "common = set.intersection(*(set(t) for t in top_by_model.values()))\n",
    "print(f'\\nShared by ALL four classical models (top-15): {sorted(common)}')"
   ]
  },
  {
