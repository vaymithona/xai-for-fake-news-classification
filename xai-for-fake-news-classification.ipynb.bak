   "source": [
    "### 8.3 Embedding Extraction\n",
    "\n",
    "Embedding extraction is a forward pass under `torch.no_grad()`. For each article, the `[CLS]` token's last hidden state is taken as a 768-dimensional summary vector."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "3bca771f",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T19:15:25.765601Z",
     "iopub.status.busy": "2026-06-11T19:15:25.765152Z",
     "iopub.status.idle": "2026-06-11T19:15:25.773133Z",
     "shell.execute_reply": "2026-06-11T19:15:25.772370Z"
    },
    "papermill": {
     "duration": 0.031469,
     "end_time": "2026-06-11T19:15:25.774736+00:00",
     "exception": false,
     "start_time": "2026-06-11T19:15:25.743267+00:00",
     "status": "completed"
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "def embed_texts(texts, batch_size=BATCH_SIZE):\n",
    "    embeddings = []\n",
    "    n = len(texts)\n",
    "    for start in range(0, n, batch_size):\n",
    "        batch = list(texts[start:start + batch_size])\n",
    "        enc = tokenizer(\n",
    "            batch,\n",
    "            padding=True,\n",
    "            truncation=True,\n",
    "            max_length=MAX_LEN,\n",
    "            return_tensors='pt',\n",
    "        ).to(DEVICE)\n",
    "        with torch.no_grad():\n",
    "            if USE_FP16:\n",
    "                with torch.autocast(device_type=DEVICE.type, dtype=torch.float16):\n",
    "                    outputs = encoder(**enc)\n",
    "            else:\n",
    "                outputs = encoder(**enc)\n",
    "        # Cast back to float32 for stable storage on host RAM.\n",
    "        cls_vec = outputs.last_hidden_state[:, 0, :].float()\n",
    "        embeddings.append(cls_vec.cpu())\n",
    "        if (start // batch_size) % 50 == 0:\n",
    "            print(f'  ... {min(start + batch_size, n):,}/{n:,}')\n",
    "    return torch.cat(embeddings, dim=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "99b94d85",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T19:15:25.817201Z",
