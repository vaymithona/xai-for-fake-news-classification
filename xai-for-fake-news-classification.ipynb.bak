"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"10.460330167718766%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_7\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.014</text><svg x=\"9.89468121613919%\" y=\"40\" height=\"20\" width=\"1.1312979031591492%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">Now This post was</text>  </svg></svg><line x1=\"9.113111307391573%\" x2=\"9.89468121613919%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_16\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"9.503896261765382%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_16\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.009</text><svg x=\"9.113111307391573%\" y=\"40\" height=\"20\" width=\"0.7815699087476169%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">commented on the recent win of France’s</text>  </svg></svg><line x1=\"8.883220854387273%\" x2=\"9.113111307391573%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_5\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"8.998166080889423%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_5\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.003</text><svg x=\"8.883220854387273%\" y=\"40\" height=\"20\" width=\"0.2298904530043%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">real professional' -</text>  </svg></svg><line x1=\"8.72712922850906%\" x2=\"8.883220854387273%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_27\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"8.805175041448166%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_27\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.002</text><svg x=\"8.72712922850906%\" y=\"40\" height=\"20\" width=\"0.15609162587821324%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">his “personal relations” with Fillon have shown the</text>  </svg></svg><line x1=\"8.571037602630845%\" x2=\"8.72712922850906%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_30\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"8.649083415569953%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_30\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.002</text><svg x=\"8.571037602630845%\" y=\"40\" height=\"20\" width=\"0.156091625878215%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">and I chaired the [Russian] government … we had a lot of meetings, and</text>  </svg></svg><line x1=\"8.41494597675263%\" x2=\"8.571037602630845%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_28\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"8.492991789691738%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_28\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.002</text><svg x=\"8.41494597675263%\" y=\"40\" height=\"20\" width=\"0.156091625878215%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">politician to be a “decent man.” “We worked</text>  </svg></svg><line x1=\"8.3408002930799%\" x2=\"8.41494597675263%\" y1=\"60\" y2=\"60\" id=\"_fb_ctvrklaoeyhgejvgafqb_ind_31\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2; opacity: 0\"/><text x=\"8.377873134916264%\" y=\"71\" font-size=\"12px\" id=\"_fs_ctvrklaoeyhgejvgafqb_ind_31\" fill=\"rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179))\" style=\"opacity: 0\" dominant-baseline=\"middle\" text-anchor=\"middle\">0.001</text><svg x=\"8.3408002930799%\" y=\"40\" height=\"20\" width=\"0.07414568367273056%\">  <svg x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">    <text x=\"50%\" y=\"9\" font-size=\"12px\" fill=\"rgb(255,255,255)\" dominant-baseline=\"middle\" text-anchor=\"middle\">have developed certain personal relations, very kind ones,”</text>  </svg></svg><g transform=\"translate(0,0)\">  <svg x=\"11.02597911929834%\" y=\"40\" height=\"18\" overflow=\"visible\" width=\"30\">    <path d=\"M 0 -9 l 6 18 L 0 25\" fill=\"none\" style=\"stroke:rgb(np.float64(255.0), np.float64(0.0), np.float64(81.0808360603179));stroke-width:2\" />  </svg></g><g transform=\"translate(2,0)\">  <svg x=\"11.02597911929834%\" y=\"40\" height=\"18\" overflow=\"visible\" width=\