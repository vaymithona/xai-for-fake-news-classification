     "status": "completed"
    },
    "tags": []
   },
   "source": [
    "### 6.2 Evaluation Helpers\n",
    "\n",
    "Two small helpers used throughout this section:\n",
    "\n",
    "- `evaluate_classifier(name, model, ...)` - fits the model, evaluates train/test accuracy, F1, precision, recall, and ROC-AUC, prints a per-class `classification_report`, and returns a metrics dict plus the per-split predictions. Accepts optional `fit_params` so models that support per-iteration tracking (XGBoost, LightGBM) can pass `eval_set` through the same code path.\n",
    "- `plot_acc_loss_curves(name, x, accs, losses, xlabel)` - draws the standard 2-panel accuracy + loss figure with Training and Testing lines.\n",
    "- `_collect_classical_curve(...)` - small utility used by Logistic Regression and Random Forest to sweep a hyperparameter (e.g. `max_iter`, `n_estimators`) and record per-step train/test accuracy and log-loss.\n",
    "\n",
    "**Methodology note on the per-iteration curves below**: the test curve is plotted purely as a diagnostic. The test set is never used to select hyperparameters or stopping points - the headline numbers in the final comparison table come from a single evaluation of the chosen model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "ab6ac5fb",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T18:49:17.345840Z",
     "iopub.status.busy": "2026-06-11T18:49:17.345361Z",
     "iopub.status.idle": "2026-06-11T18:49:17.353040Z",
     "shell.execute_reply": "2026-06-11T18:49:17.352270Z"
    },
    "papermill": {
     "duration": 0.022379,
     "end_time": "2026-06-11T18:49:17.354586+00:00",
     "exception": false,
     "start_time": "2026-06-11T18:49:17.332207+00:00",
     "status": "completed"
    },
    "tags": []
   },
   "outputs": [],
   "source": [
    "def evaluate_classifier(name, model, X_tr, y_tr, X_te, y_te, fit_params=None):\n",
    "    \"\"\"Fit, evaluate on train and test, print report, return (metrics_dict, preds_dict).\n",
    "\n",
    "    `fit_params` lets callers pass eval_set, callbacks, etc. to model.fit().\n",
    "    \"\"\"\n",
    "    if fit_params is None:\n",
    "        fit_params = {}\n",
    "    model.fit(X_tr, y_tr, **fit_params)\n",
    "    preds = {\n",
    "        'train': model.predict(X_tr),\n",
    "        'test':  model.predict(X_te),\n",
    "    }\n",
    "    metrics = {\n",
    "        'Model':     name,\n",
    "        'TrainAcc':  accuracy_score(y_tr,  preds['train']),\n",
    "        'TestAcc':   accuracy_score(y_te,  preds['test']),\n",
    "        'F1':        f1_score(y_te,         preds['test']),\n",
    "        'Precision': precision_score(y_te,  preds['test']),\n",
    "        'Recall':    recall_score(y_te,     preds['test']),\n",
    "    }\n",
    "    if hasattr(model, 'predict_proba'):\n",
    "        prob = model.predict_proba(X_te)[:, 1]\n",
    "        metrics['ROC-AUC'] = roc_auc_score(y_te, prob)\n",
    "    else:\n",
    "        metrics['ROC-AUC'] = float('nan')\n",
    "\n",
    "    print(f'=== {name} ===')\n",
    "    print(f'Train acc: {metrics[\"TrainAcc\"]:.4f}  |  Test acc: {metrics[\"TestAcc\"]:.4f}')\n",
    "    print(f'Test F1: {metrics[\"F1\"]:.4f}  Precision: {metrics[\"Precision\"]:.4f}  Recall: {metrics[\"Recall\"]:.4f}  ROC-AUC: {metrics[\"ROC-AUC\"]:.4f}')\n",
    "    print()\n",
    "    print(classification_report(y_te, preds['test'], target_names=['Real', 'Fake']))\n",
    "    return metrics, preds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "d6a9103d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-11T18:49:17.380574Z",
